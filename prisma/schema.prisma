// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  STAFF
  USER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(USER)
  // minha versao: Supervisor responsavel (para quem e "Equipe"). O Supervisor ve a auditoria da equipe dele.
  supervisorId String?
  supervisor   User?   @relation("Supervisao", fields: [supervisorId], references: [id], onDelete: SetNull)
  equipe       User[]  @relation("Supervisao")
  apiKey    String?  @unique // API Key for authentication
  // minha versao: 2FA (TOTP) — usado so para SUPERADMIN. twoFactorSecret guardado so apos confirmar um codigo valido.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  // minha versao: LGPD — versao dos Termos/Privacidade aceita (null = nunca aceitou). Ver src/lib/termos.ts
  termosVersao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sessions  Session[]
  webhooks  Webhook[]
  notifications Notification[]
  sessionAccesses SessionAccess[]
  aceitesTermos AceiteTermos[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  name        String    // e.g. "Marketing WA"
  sessionId   String    @unique // The unique ID used for Baileys auth
  status      String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ZOMBIE
  privada     Boolean   @default(false) // minha versao: so o dono ve e usa (nem outro Super Administrador); nao pode ser compartilhada
  qr          String?   @db.Text
  config      Json?     // Store instance specific config (e.g. "read_receipts": true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  messages    Message[]
  groups      Group[]
  autoReplies AutoReply[]
  stories     Story[]
  scheduledMessages ScheduledMessage[]
  webhooks    Webhook[]
  botConfig   BotConfig?
  sessionAccesses SessionAccess[]
}

model Contact {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // remoteJid (123456@s.whatsapp.net)
  lid         String?  // LID JID
  name        String?
  notify      String?  // Pushname
  verifiedName String? // Business Name
  remoteJidAlt String? // Alternate JID (e.g. Phone if JID is LID)
  profilePic  String?  @db.Text
  data        Json?    // Detailed contact data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([sessionId, jid])
}

model Message {
  id          String        @id @default(cuid())
  sessionId   String
  remoteJid   String        // Receiver or Group Jid
  senderJid   String?       // If group, who sent it. If private, same as remoteJid (incoming) or me (outgoing)
  fromMe      Boolean
  keyId       String        // WhatsApp Message Key ID
  pushName    String?
  type        MessageType   @default(TEXT)
  content     String?       @db.Text // Text content or Caption
  mediaUrl    String?       @db.Text // Path to file if media
  status      MessageStatus @default(PENDING)
  timestamp   DateTime      @default(now())
  
  quoteId     String?       // For replies
  sentBy      String?       // minha versao: nome do usuario do painel que enviou (atendente)
  extra       Json?         // minha versao: dados estruturados (ex.: contatos encaminhados: nome + numeros do vCard)
  reacoes     Json?         // minha versao: reacoes com emoji { quem: { e: "👍", n: "Nome" } } ("eu" = este numero)
  origemEnvio String?       // minha versao: mensagens minhas: PLATAFORMA (painel/API/bot/agendador) | FORA (celular/outro aparelho)
  
  contactId   String?
  contract    Contact?      @relation(fields: [contactId], references: [id])
  session     Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, keyId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, remoteJid, timestamp])
  @@index([timestamp]) // minha versao: retencao (LGPD) apaga por data
}

// minha versao: registro de auditoria (por enquanto: mensagens apagadas — quem apagou, o que era, de quem)
model Auditoria {
  id          String    @id @default(cuid())
  sessionId   String    // Session.sessionId (texto)
  acao        String    // MENSAGEM_APAGADA
  origem      String    // PAINEL (usuario do painel) | CONTATO (quem enviou apagou no WhatsApp) | CELULAR (este numero apagou fora do painel)
  modo        String?   // TODOS (apagada para todos) | PARA_MIM (so neste aparelho)
  usuarioId   String?   // usuario do painel (origem PAINEL)
  usuarioNome String?   // quem apagou (usuario do painel ou nome/numero de quem apagou no WhatsApp)
  chatJid     String
  chatNome    String?
  keyId       String?
  autorJid    String?   // quem ESCREVEU a mensagem
  autorNome   String?
  fromMe      Boolean   @default(false)
  tipo        String?
  conteudo    String?   @db.Text
  mediaUrl    String?   @db.Text
  enviadaEm   DateTime?
  criadoEm    DateTime  @default(now())

  @@index([sessionId, criadoEm])
}

// minha versao: ate quando cada conversa foi lida no painel (para contar as nao lidas da lista)
model ChatLeitura {
  id        String   @id @default(cuid())
  sessionId String   // Session.id (cuid)
  jid       String
  lidoEm    DateTime
  naoLida   Boolean  @default(false) // minha versao: "marcar como nao lida" (no painel ou no celular)

  @@unique([sessionId, jid])
}

// minha versao: estado da conversa espelhado do WhatsApp (celular e painel): arquivada, silenciada, fixada
// e as mensagens fixadas dentro dela. Antes isso so ia para o WhatsApp e o painel esquecia.
model ChatEstado {
  id            String    @id @default(cuid())
  sessionId     String    // Session.id (cuid)
  jid           String
  arquivada     Boolean   @default(false)
  silenciadaAte DateTime? // null = som ligado; ano 9999 = "sempre"
  fixadaEm      DateTime? // conversa fixada no topo (null = nao fixada)
  fixadas       Json?     // mensagens fixadas: [{ keyId, por, em, ate }] (o WhatsApp deixa ate 3)
  atualizadoEm  DateTime  @updatedAt

  @@unique([sessionId, jid])
  @@index([sessionId, arquivada])
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  subject     String?
  description String?  @db.Text
  ownerJid    String?
  participants Json?   // Stored as JSON for now: [{id: '123@s.whatsapp.net', admin: 'admin' | null}]
  creation    DateTime?
  restrict    Boolean? // Only admins can edit group info
  announce    Boolean? // Only admins can send messages
  
  metadata    Json?    // Raw full metadata dump
  
  inviteCode  String?
  
  // Community Features
  isCommunity Boolean  @default(false)
  linkedParentJid String? // JID of the community parent group if it belongs to one
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
}

model AutoReply {
  id          String   @id @default(cuid())
  sessionId   String
  keyword     String
  matchType   String   // EXACT, CONTAINS, REGEX
  response    String?  @db.Text
  isMedia     Boolean  @default(false)
  mediaUrl    String?
  mediaType   String?
  triggerType String   @default("ALL") // ALL, GROUP, PRIVATE
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Story {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String   // User who posted the story or Broadcast JID
  content     String?  @db.Text
  mediaUrl    String?  @db.Text
  type        String   // IMAGE, VIDEO, TEXT
  timestamp   DateTime @default(now())
  viewed      Boolean  @default(false)

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ScheduledMessage {
  id          String   @id @default(cuid())
  sessionId   String
  jid         String
  content     String?  @db.Text
  mediaUrl    String?
  mediaType   String?  // image, video, document, etc.
  sendAt      DateTime
  cronExpression String? // e.g., '*/5 * * * *'
  recurrenceRule String? @db.Text // UI JSON state
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  createdAt   DateTime @default(now())

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Store for Baileys MultiFileAuthState (in DB)
model AuthState {
  id        String   @id @default(cuid())
  sessionId String
  key       String   // Filename/Key (creds.json, etc)
  value     Json
  
  @@unique([sessionId, key])
}

// Webhook configuration for external event notifications
model Webhook {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String?  // Optional: specific session, null = all sessions
  name        String   // e.g. "My Server Webhook"
  url         String   // The webhook endpoint URL
  secret      String?  // Optional secret for HMAC signing
  events      Json     // Array of event types: ["message.received", "message.sent", "connection.update", etc.]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]
}

// Webhook delivery logs — tracks every webhook request attempt
model WebhookLog {
  id                 String   @id @default(cuid())
  webhookId          String
  event              String   // The event that triggered this webhook
  status             String   // SUCCESS, FAILED
  requestUrl         String   @db.Text
  requestHeaders     Json?
  requestBody        Json?
  responseStatusCode Int?
  responseBody       String?  @db.Text
  responseTimeMs     Int?
  errorMessage       String?  @db.Text
  createdAt          DateTime @default(now())

  webhook            Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
}

enum AccessMode {
  ALL
  OWNER
  SPECIFIC
  BLACKLIST
}

model BotConfig {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  enabled       Boolean  @default(true)
  
  // Bot Command Access
  botName       String   @default("ZapHub Bot")
  botMode       AccessMode @default(OWNER)
  botAllowedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"]
  botBlockedJids Json?     // Array of JIDs ["628123@s.whatsapp.net"] for BLACKLIST mode

  // Auto Reply Access
  autoReplyMode AccessMode @default(ALL)
  autoReplyAllowedJids Json?
  autoReplyBlockedJids Json? // Array of JIDs for BLACKLIST mode

  enableSticker Boolean  @default(true)
  enableVideoSticker Boolean @default(true)
  maxStickerDuration Int @default(10) // in seconds
  enablePing    Boolean  @default(true)
  enableUptime  Boolean  @default(true)
  removeBgApiKey String?
  prefix        String   @default("#")
  
  // Anti-Spam / Rate Limit
  antiSpamEnabled Boolean @default(false)
  spamLimit       Int     @default(5)    // Messages allowed in window
  spamInterval    Int     @default(10)   // Seconds window
  spamDelayMin    Int     @default(1000) // MS min delay
  spamDelayMax    Int     @default(3000) // MS max delay

  // Automation & Presence
  welcomeMessage  String? @db.Text
  autoRead        Boolean @default(false)
  alwaysOnline    Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                 String   @id @default("default") // Singleton ID
  appName            String   @default("ZapHub")
  logoUrl            String?
  faviconUrl         String?
  timezone           String   @default("America/Sao_Paulo") // minha versao: era Asia/Jakarta
  enableRegistration Boolean  @default(false)
  pastaMidia         String?  @db.VarChar(255) // minha versao: pasta das midias (null = <app>/data/media). Ver src/lib/pasta-midia.ts
  // minha versao: LGPD — retencao em dias (null = guardar para sempre)
  retencaoMensagensDias Int?
  retencaoMidiasDias    Int?
  retencaoLogsDias      Int?

  updatedAt          DateTime @updatedAt
}

// minha versao: trilha de auditoria de ACESSO/ADMIN (login, 2FA, usuarios, papeis, senha).
// Separado do modelo Auditoria (que e so de mensagens apagadas).
model LogAcesso {
  id           String   @id @default(cuid())
  quando       DateTime @default(now())
  tipo         String   // LOGIN_OK, LOGIN_FALHA, LOGIN_2FA_FALHA, LOGOUT, 2FA_ATIVADO, 2FA_DESATIVADO,
                         // USUARIO_CRIADO, USUARIO_REMOVIDO, PAPEL_ALTERADO, SENHA_TROCADA, SESSAO_COMPARTILHADA
  usuarioId    String?  // quem fez a acao (null em login falho de usuario inexistente)
  usuarioEmail String?  // email usado/tentado
  alvo         String?  // alvo da acao (ex.: email do usuario afetado, sessionId)
  ip           String?
  detalhe      String?  @db.Text

  @@index([quando])
  @@index([tipo])
  @@index([usuarioId])
}

// Labels/Tags for organizing chats
model Label {
  id          String      @id @default(cuid())
  sessionId   String
  name        String
  color       Int         @default(0) // 0-19 for WhatsApp color codes
  colorHex    String      @default("#FF0000") // Hex representation
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  chatLabels  ChatLabel[]
  
  @@unique([sessionId, name]) // Unique label name per session
  @@index([sessionId])
}

// Many-to-many relationship between chats and labels
model ChatLabel {
  id        String   @id @default(cuid())
  labelId   String
  chatJid   String   // The JID of the chat
  createdAt DateTime @default(now())
  
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  
  @@unique([labelId, chatJid]) // Prevent duplicate label assignments
  @@index([chatJid])
  @@index([labelId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, SYSTEM
  read      Boolean  @default(false)
  href      String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared session access — allows session owners to grant access to other users
model SessionAccess {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

// Broadcast/Blast history & logs
model BroadcastLog {
  id          String              @id @default(cuid())
  sessionId   String              // WA session ID string
  message     String              @db.Text
  total       Int
  sent        Int                 @default(0)
  failed      Int                 @default(0)
  status      String              @default("running") // running, completed, cancelled
  delay       Int                 @default(2000)
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  recipients  BroadcastRecipient[]

  @@index([sessionId])
  @@index([sessionId, startedAt])
}

model BroadcastRecipient {
  id              String       @id @default(cuid())
  broadcastLogId  String
  jid             String
  status          String       @default("pending") // pending, sent, failed
  error           String?      @db.Text
  sentAt          DateTime?

  broadcastLog    BroadcastLog @relation(fields: [broadcastLogId], references: [id], onDelete: Cascade)

  @@index([broadcastLogId])
}

// minha versao: LGPD — registro de cada aceite dos Termos/Privacidade (prova de consentimento)
model AceiteTermos {
  id        String   @id @default(cuid())
  userId    String
  versao    String
  aceitoEm  DateTime @default(now())
  ip        String?
  userAgent String?  @db.Text

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// minha versao: LGPD — pedidos de titulares (contatos do WhatsApp): acesso, correcao, exclusao, oposicao
model PedidoTitular {
  id          String    @id @default(cuid())
  sessionId   String?   // Session.sessionId (texto), opcional
  titular     String    // telefone (so digitos) ou jid
  nome        String?
  tipo        String    // ACESSO | CORRECAO | EXCLUSAO | OPOSICAO | OUTRO
  descricao   String    @db.Text
  status      String    @default("ABERTO") // ABERTO | CONCLUIDO | RECUSADO
  resposta    String?   @db.Text
  criadoPorId String?
  criadoEm    DateTime  @default(now())
  concluidoEm DateTime?

  @@index([status])
  @@index([criadoEm])
}
