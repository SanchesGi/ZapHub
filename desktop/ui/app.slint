// Telas do ZapHub para Windows (Slint). Identidade do ZapHub: grafite neutro com destaque ambar (#F4A935),
// as mesmas cores do tema escuro do painel. Nada imita o WhatsApp.
import { LineEdit, ListView, Spinner, ScrollView } from "std-widgets.slint";
import { Tema, Icone, BotaoIcone, Botao, Campo, Avatar } from "base.slint";
import { Painel, ContatoItem, ParticipanteItem, MenuConversa, CamadasPainel, PainelInfo } from "painel.slint";
export { Painel, ContatoItem, ParticipanteItem } from "painel.slint";
import { Acoes, ReacaoItem, CitacaoBloco, ChipReacao, BotaoMais, FaixaResposta, FaixaEdicao, PainelBusca, CamadaAcoes } from "acoes.slint";
export { Acoes, ReacaoItem, DestinoItem, ResultadoBusca } from "acoes.slint";

export struct Conversa {
    jid: string,
    nome: string,
    inicial: string,
    cor: int,
    previa: string,
    hora: string,
    nao-lidas: int,
    marcada: bool,
    grupo: bool,
    fixada: bool,
    silenciada: bool,
    minha: bool,
    status: string,
    foto: image,
    tem-foto: bool,
}

export struct Mensagem {
    id: string,
    minha: bool,
    texto: string,
    hora: string,
    autor: string,
    cor: int,
    status: string,
    dia: string,
    rotulo: string,
    nova: bool,
    tem-imagem: bool,
    imagem: image,
    carregando-imagem: bool,
    img-largura: float,
    img-altura: float,
    arquivo: string,
    tem-arquivo: bool,
    indisponivel: bool,
    eh-audio: bool,
    tocando: bool,
    progresso: float,
    tempo: string,
    citada: bool,
    citada-id: string,
    citada-autor: string,
    citada-texto: string,
    reacoes: [ReacaoItem],
    encaminhada: bool,
    editada: bool,
    apagada: bool,
}

export struct SessaoItem {
    nome: string,
    conectada: bool,
    privada: bool,
}


component Marca inherits HorizontalLayout {
    in property <length> tamanho: 28px;
    spacing: 10px;
    alignment: start;
    Image { source: @image-url("icone.png"); width: root.tamanho; height: root.tamanho; }
    Text { text: "ZapHub"; color: Tema.texto; font-size: root.tamanho * 0.72; font-weight: 800; vertical-alignment: center; letter-spacing: -0.3px; }
}

// ---------- telas de entrada (servidor e login) ----------
component Moldura inherits Rectangle {
    background: Tema.fundo;
    property <float> entrada: 0;
    opacity: entrada;
    animate entrada { duration: 280ms; easing: ease-out; }
    init => { entrada = 1; }
    HorizontalLayout {
        // painel da marca
        Rectangle {
            width: parent.width > 980px ? 420px : 0px;
            visible: parent.width > 980px;
            background: @linear-gradient(160deg, #1E1A12 0%, #151513 55%, #111110 100%);
            VerticalLayout {
                padding: 48px;
                spacing: 18px;
                Marca { tamanho: 40px; }
                Rectangle { height: 24px; }
                Text { text: "O atendimento da sua empresa\nem um só lugar."; color: Tema.texto; font-size: 28px; font-weight: 700; wrap: word-wrap; }
                Text { text: "Conversas, equipe e histórico no servidor da sua empresa. Este programa só conecta no servidor que você confirmar."; color: Tema.apagado; font-size: 15px; wrap: word-wrap; }
                Rectangle { }
                HorizontalLayout {
                    spacing: 10px;
                    Icone { source: @image-url("icones/escudo.svg"); cor: Tema.destaque; }
                    Text { text: "Certificado fixado · login protegido pelo Windows"; color: Tema.apagado; font-size: 12px; vertical-alignment: center; }
                }
            }
        }
        Rectangle {
            @children
        }
    }
}

component TelaServidor inherits Rectangle {
    in-out property <string> endereco;
    in property <string> erro;
    in property <bool> ocupado;
    in property <bool> mostrar-cert;
    in property <string> cert-impressao;
    in property <string> cert-titular;
    in property <string> cert-emissor;
    in property <string> cert-validade;
    /// ja havia uma identidade confirmada para este endereco e ela NAO bate: alerta forte
    in property <bool> cert-mudou;
    in property <bool> cert-liberado;
    in property <string> cert-prefixo;
    in property <string> versao;
    callback verificar(string);
    callback confiar();
    callback cancelar();
    callback cert-digitado(string);
    property <string> digitado;

    Moldura {
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(480px, root.width - 48px);
                    spacing: 16px;
                    Icone { source: @image-url("icones/servidor.svg"); cor: Tema.destaque; width: 32px; height: 32px; }
                    Text {
                        text: root.mostrar-cert ? (root.cert-mudou ? "A identidade do servidor mudou" : "Confirme o certificado") : "Conectar ao servidor";
                        color: root.mostrar-cert && root.cert-mudou ? #F3B2B4 : Tema.texto; font-size: 24px; font-weight: 700; wrap: word-wrap;
                    }
                    if !root.mostrar-cert || !root.cert-mudou: Text {
                        text: root.mostrar-cert
                            ? "Compare a impressão digital abaixo com a que o administrador do servidor passou. Se for igual, confie."
                            : "Informe o endereço do servidor ZapHub da sua empresa. Quem administra o servidor sabe qual é.";
                        color: Tema.apagado; wrap: word-wrap;
                    }
                    if root.mostrar-cert && root.cert-mudou: Rectangle {
                        background: Tema.erro-fundo; border-radius: 10px;
                        border-width: 2px; border-color: Tema.erro;
                        height: alerta-l.preferred-height;
                        alerta-l := VerticalLayout {
                            padding: 16px; spacing: 10px;
                            HorizontalLayout {
                                spacing: 10px;
                                Icone { source: @image-url("icones/alerta.svg"); cor: Tema.erro; width: 22px; height: 22px; }
                                Text { text: "Este endereço já tinha outra identidade confirmada"; color: #F3B2B4; font-weight: 700; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                            }
                            Text {
                                text: "Se o administrador não avisou que trocou a chave ou o certificado do servidor, alguém pode estar se passando por ele para ler suas conversas e capturar seu login. Nesse caso, NÃO continue e avise o administrador por outro meio (telefone, pessoalmente).\n\nSe a troca foi combinada, peça a ele a impressão digital nova, confira com a mostrada abaixo e digite aqui os 4 primeiros pares (os 8 primeiros caracteres) para liberar o botão.";
                                color: #F3B2B4; wrap: word-wrap;
                            }
                            Campo {
                                rotulo: "Os 4 primeiros pares da impressão digital nova";
                                dica: root.cert-prefixo != "" ? "Exemplo no formato: AB:CD:EF:01" : "";
                                texto <=> root.digitado;
                                habilitado: !root.ocupado;
                                changed texto => { root.cert-digitado(self.texto); }
                            }
                        }
                    }
                    if !root.mostrar-cert: Campo {
                        rotulo: "Endereço do servidor";
                        dica: "https://192.168.0.10:3443";
                        texto <=> root.endereco;
                        habilitado: !root.ocupado;
                        confirmado => { root.verificar(self.texto); }
                    }
                    if root.mostrar-cert: Rectangle {
                        background: Tema.cartao;
                        border-radius: 12px;
                        border-width: 1px; border-color: Tema.borda;
                        height: cert.preferred-height;
                        cert := VerticalLayout {
                            padding: 18px; spacing: 4px;
                            Text { text: "IMPRESSÃO DIGITAL (SHA-256)"; color: Tema.fraco; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                            Text { text: root.cert-impressao; color: Tema.destaque; wrap: char-wrap; font-family: "Cascadia Mono"; font-size: 13px; }
                            Rectangle { height: 10px; }
                            Text { text: "TITULAR"; color: Tema.fraco; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                            Text { text: root.cert-titular; color: Tema.texto; wrap: word-wrap; }
                            Rectangle { height: 6px; }
                            Text { text: "EMISSOR"; color: Tema.fraco; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                            Text { text: root.cert-emissor; color: Tema.texto; wrap: word-wrap; }
                            Rectangle { height: 6px; }
                            Text { text: "VÁLIDO ATÉ"; color: Tema.fraco; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; }
                            Text { text: root.cert-validade; color: Tema.texto; }
                        }
                    }
                    if root.erro != "": Rectangle {
                        background: Tema.erro-fundo; border-radius: 8px;
                        height: erro-l.preferred-height;
                        erro-l := HorizontalLayout {
                            padding: 12px; spacing: 10px;
                            Icone { source: @image-url("icones/alerta.svg"); cor: Tema.erro; }
                            Text { text: root.erro; color: #F3B2B4; wrap: word-wrap; vertical-alignment: center; }
                        }
                    }
                    HorizontalLayout {
                        alignment: end; spacing: 10px;
                        if root.mostrar-cert: Botao { texto: "Voltar"; principal: false; clicado => { root.cancelar(); } }
                        if root.mostrar-cert: Botao {
                            texto: root.cert-mudou ? "Confio nesta nova identidade" : "Confiar e conectar";
                            ativo: !root.ocupado && (!root.cert-mudou || root.cert-liberado);
                            clicado => { root.confiar(); }
                        }
                        if !root.mostrar-cert: Botao { texto: root.ocupado ? "Verificando" : "Continuar"; ocupado: root.ocupado; ativo: !root.ocupado && root.endereco != ""; clicado => { root.verificar(root.endereco); } }
                    }
                    Text { text: root.versao; color: Tema.fraco; font-size: 11px; }
                }
            }
        }
    }
}

component TelaEntrar inherits Rectangle {
    in property <string> servidor;
    in-out property <string> email;
    in property <string> erro;
    in property <bool> ocupado;
    in property <bool> pede-codigo;
    in property <string> versao;
    callback entrar(string, string, string);
    callback trocar-servidor();
    property <string> senha;
    property <string> codigo;

    Moldura {
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(400px, root.width - 48px);
                    spacing: 16px;
                    Text { text: "Entrar"; color: Tema.texto; font-size: 26px; font-weight: 700; }
                    HorizontalLayout {
                        spacing: 8px;
                        Icone { source: @image-url("icones/cadeado.svg"); cor: Tema.ok; width: 14px; height: 14px; }
                        Text { text: root.servidor; color: Tema.apagado; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        Text {
                            text: "Trocar"; color: Tema.destaque; font-size: 12px; vertical-alignment: center;
                            TouchArea { mouse-cursor: pointer; clicked => { root.trocar-servidor(); } }
                        }
                    }
                    campo-email := Campo { rotulo: "E-mail"; dica: "voce@empresa.com"; texto <=> root.email; habilitado: !root.ocupado; tipo: text; confirmado => { campo-senha.focar(); } }
                    campo-senha := Campo { rotulo: "Senha"; senha: true; texto <=> root.senha; habilitado: !root.ocupado; confirmado => { root.entrar(root.email, root.senha, root.codigo); } }
                    if root.pede-codigo: Campo {
                        rotulo: "Código de verificação (2FA)";
                        dica: "6 dígitos do aplicativo autenticador";
                        tipo: number;
                        texto <=> root.codigo;
                        habilitado: !root.ocupado;
                        init => { self.focar(); }
                        confirmado => { root.entrar(root.email, root.senha, root.codigo); }
                    }
                    if root.erro != "": Rectangle {
                        background: Tema.erro-fundo; border-radius: 8px;
                        height: erro-l.preferred-height;
                        erro-l := HorizontalLayout {
                            padding: 12px; spacing: 10px;
                            Icone { source: @image-url("icones/alerta.svg"); cor: Tema.erro; }
                            Text { text: root.erro; color: #F3B2B4; wrap: word-wrap; vertical-alignment: center; }
                        }
                    }
                    Botao { texto: root.ocupado ? "Entrando" : "Entrar"; ocupado: root.ocupado; ativo: !root.ocupado && root.email != "" && root.senha != ""; clicado => { root.entrar(root.email, root.senha, root.codigo); } }
                    Text { text: root.versao; color: Tema.fraco; font-size: 11px; horizontal-alignment: center; }
                }
            }
        }
    }
}

// ---------- atendimento ----------
component Aba inherits Rectangle {
    in property <string> texto;
    in property <bool> ativa;
    callback clicada();
    height: 30px;
    width: t.preferred-width + 24px;
    border-radius: 15px;
    background: ativa ? Tema.destaque-suave : toque.has-hover ? Tema.realce : transparent;
    border-width: 1px;
    border-color: ativa ? Tema.destaque.transparentize(50%) : Tema.borda;
    animate background, border-color { duration: 160ms; }
    t := Text { text: root.texto; color: root.ativa ? Tema.destaque : Tema.apagado; font-size: 12px; font-weight: 600; }
    toque := TouchArea { mouse-cursor: pointer; clicked => { root.clicada(); } }
}

component ItemConversa inherits Rectangle {
    in property <Conversa> c;
    in property <bool> selecionada;
    // na aba Arquivadas todas estao arquivadas
    in property <bool> arquivada;
    callback clicado();
    property <length> menu-x;
    property <length> menu-y;
    height: 72px;
    border-radius: 10px;
    background: selecionada ? Tema.realce : toque.has-hover ? Tema.cartao : transparent;
    animate background { duration: 140ms; }
    Rectangle {
        x: 0; width: 3px; border-radius: 2px; background: Tema.destaque;
        height: root.selecionada ? 32px : 0px;
        y: (root.height - self.height) / 2;
        animate height { duration: 200ms; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Avatar { inicial: c.inicial; cor: c.cor; grupo: c.grupo; foto: c.foto; tem-foto: c.tem-foto; } }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: c.nome; color: Tema.texto; font-weight: c.nao-lidas > 0 || c.marcada ? 700 : 600; overflow: elide; horizontal-stretch: 1; font-size: 14px; }
                Text { text: c.hora; color: c.nao-lidas > 0 || c.marcada ? Tema.destaque : Tema.fraco; font-size: 11px; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: 6px;
                if c.minha && c.status != "": Icone {
                    source: c.status == "READ" || c.status == "DELIVERED" || c.status == "PLAYED" ? @image-url("icones/tiques.svg") : @image-url("icones/tique.svg");
                    cor: c.status == "READ" || c.status == "PLAYED" ? Tema.destaque : Tema.fraco;
                    width: 14px; height: 14px; y: 1px;
                }
                Text { text: c.previa; color: c.nao-lidas > 0 ? Tema.texto.transparentize(15%) : Tema.apagado; overflow: elide; horizontal-stretch: 1; font-size: 13px; }
                if c.silenciada: Icone { source: @image-url("icones/mudo.svg"); cor: Tema.fraco; width: 14px; height: 14px; y: 2px; }
                if c.fixada: Icone { source: @image-url("icones/fixar.svg"); cor: Tema.fraco; width: 14px; height: 14px; y: 2px; }
                if c.nao-lidas > 0 || c.marcada: Rectangle {
                    width: max(20px, numero.preferred-width + 12px); height: 20px; border-radius: 10px;
                    background: c.silenciada ? Tema.fraco : Tema.destaque;
                    numero := Text { text: c.nao-lidas > 0 ? (c.nao-lidas > 99 ? "99+" : c.nao-lidas) : ""; color: Tema.sobre-destaque; font-size: 11px; font-weight: 800; }
                }
            }
        }
    }
    toque := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicado(); }
        // botao direito: menu da conversa (abre sobre o ponteiro; sobe se nao couber embaixo)
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up) {
                root.menu-x = self.mouse-x;
                root.menu-y = (self.absolute-position.y + self.mouse-y + 330px > Painel.janela-altura) ? max(-self.absolute-position.y, self.mouse-y - 300px) : self.mouse-y;
                menu.show();
            }
        }
    }
    menu := PopupWindow {
        x: root.menu-x; y: root.menu-y;
        close-policy: close-on-click-outside;
        MenuConversa {
            jid: root.c.jid; fixada: root.c.fixada; silenciada: root.c.silenciada; arquivada: root.arquivada;
            nao-lida: root.c.nao-lidas > 0 || root.c.marcada;
            fechar => { menu.close(); }
        }
    }
}

component CartaoArquivo inherits Rectangle {
    in property <string> nome;
    in property <bool> minha;
    callback abrir();
    callback salvar();
    height: 56px;
    min-width: 240px;
    border-radius: 8px;
    background: minha ? #00000026 : #FFFFFF0A;
    HorizontalLayout {
        padding-left: 10px; padding-right: 6px; spacing: 10px;
        VerticalLayout { alignment: center; Rectangle {
            width: 36px; height: 36px; border-radius: 8px; background: Tema.destaque-suave;
            Icone {
                source: root.nome.to-lowercase().ends-with(".mp4") || root.nome.to-lowercase().ends-with(".mov") || root.nome.to-lowercase().starts-with("video") ? @image-url("icones/video.svg")
                    : root.nome.to-lowercase().starts-with("audio") || root.nome.to-lowercase().ends-with(".ogg") || root.nome.to-lowercase().ends-with(".mp3") ? @image-url("icones/musica.svg")
                    : @image-url("icones/arquivo.svg");
                cor: Tema.destaque;
            }
        } }
        Text { text: root.nome; color: Tema.texto; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; }
        VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/abrir.svg"); tamanho: 32px; dica: "Abrir"; clicado => { root.abrir(); } } }
        VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/baixar.svg"); tamanho: 32px; dica: "Salvar como…"; clicado => { root.salvar(); } } }
    }
}

component Balao inherits Rectangle {
    in property <Mensagem> m;
    in property <length> largura;
    callback abrir-midia(string);
    callback salvar-midia(string);
    callback tocar(string);
    // pede para a lista centralizar este balao (posicao e altura dentro do conteudo)
    callback centralizar(length, length);
    height: linha.preferred-height;
    property <float> entrada: m.nova ? 0 : 1;
    property <bool> em-destaque: Acoes.alvo-id == m.id;
    property <bool> tem-midia: m.tem-imagem || m.tem-arquivo || m.eh-audio;
    opacity: entrada;
    animate entrada { duration: 260ms; easing: ease-out; }
    init => { entrada = 1; }
    // quando este balao e o alvo (clique numa citacao ou num resultado), centraliza na lista
    Timer {
        interval: 100ms;
        running: root.em-destaque && Acoes.alvo-pendente;
        triggered => { root.centralizar(root.y, root.height); Acoes.alvo-pendente = false; }
    }
    // o TouchArea e o pai de tudo: assim o hover e o botao direito funcionam ate por cima do texto,
    // e a selecao do texto (TextInput) continua com o botao esquerdo
    toque := TouchArea {
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up && !m.apagada) {
                Acoes.abrir-menu(m.id, m.minha, m.texto != "" && !m.apagada, root.tem-midia, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        linha := VerticalLayout {
            padding-top: 2px; padding-bottom: 2px;
            if m.dia != "": HorizontalLayout {
                alignment: center;
                padding-top: 14px; padding-bottom: 10px;
                Rectangle {
                    background: Tema.elevado; border-radius: 12px;
                    height: 24px; width: dia.preferred-width + 24px;
                    dia := Text { text: m.dia; color: Tema.apagado; font-size: 11px; font-weight: 600; }
                }
            }
            HorizontalLayout {
                alignment: m.minha ? end : start;
                padding-left: 24px; padding-right: 24px;
                VerticalLayout {
                    spacing: 3px;
                    Rectangle {
                        background: m.minha ? Tema.minha : Tema.outra;
                        border-width: 1px;
                        border-color: m.minha ? Tema.minha-borda : Tema.borda;
                        border-radius: 12px;
                        border-bottom-right-radius: m.minha ? 4px : 12px;
                        border-bottom-left-radius: m.minha ? 12px : 4px;
                        max-width: min(640px, root.largura * 0.68);
                        VerticalLayout {
                            padding-top: 8px; padding-bottom: 6px; padding-left: 12px; padding-right: 12px;
                            spacing: 3px;
                            if m.autor != "": Text { text: m.autor; color: m.minha ? Tema.destaque : Tema.pessoas[Math.mod(m.cor, 10)]; font-size: 12px; font-weight: 700; }
                            if m.encaminhada: HorizontalLayout {
                                spacing: 5px;
                                VerticalLayout { alignment: center; Icone { source: @image-url("icones/acao-encaminhar.svg"); cor: Tema.fraco; width: 12px; height: 12px; } }
                                Text { text: "Encaminhada"; color: Tema.fraco; font-size: 11px; vertical-alignment: center; font-italic: true; }
                            }
                            if m.citada: CitacaoBloco {
                                autor: m.citada-autor; texto: m.citada-texto; minha-msg: m.minha;
                                clicado => { Acoes.ir-para(m.citada-id); }
                            }
                            if m.tem-imagem: Rectangle {
                                width: m.img-largura * 1px; height: m.img-altura * 1px;
                                border-radius: 8px; clip: true;
                                background: Tema.elevado;
                                if m.carregando-imagem: Spinner { width: 22px; height: 22px; indeterminate: true; }
                                if !m.carregando-imagem: Image { width: parent.width; height: parent.height; source: m.imagem; image-fit: cover; }
                                foto-t := TouchArea { mouse-cursor: pointer; clicked => { root.abrir-midia(m.id); } }
                                if foto-t.has-hover && !m.carregando-imagem: Rectangle {
                                    x: parent.width - 40px; y: 6px; width: 34px; height: 34px; border-radius: 17px; background: #000000A0;
                                    Icone { source: @image-url("icones/baixar.svg"); cor: #FFFFFF; width: 16px; height: 16px; }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.salvar-midia(m.id); } }
                                }
                            }
                            if m.eh-audio: Rectangle {
                                height: 52px; min-width: 260px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout { alignment: center; Rectangle {
                                        width: 40px; height: 40px; border-radius: 20px;
                                        background: play-t.has-hover ? Tema.destaque.brighter(8%) : Tema.destaque;
                                        animate background { duration: 140ms; }
                                        Icone { source: m.tocando ? @image-url("icones/pausa.svg") : @image-url("icones/play.svg"); cor: Tema.sobre-destaque; width: 18px; height: 18px; }
                                        play-t := TouchArea { mouse-cursor: pointer; clicked => { root.tocar(m.id); } }
                                    } }
                                    VerticalLayout {
                                        alignment: center; spacing: 6px;
                                        Rectangle {
                                            height: 4px; border-radius: 2px; background: m.minha ? #00000040 : Tema.borda;
                                            Rectangle {
                                                x: 0; height: parent.height; border-radius: 2px; background: Tema.destaque;
                                                width: parent.width * m.progresso;
                                                animate width { duration: 200ms; }
                                            }
                                        }
                                        Text { text: m.tempo != "" ? m.tempo : "Mensagem de voz"; color: Tema.apagado; font-size: 11px; }
                                    }
                                    VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/baixar.svg"); tamanho: 30px; dica: "Salvar como…"; clicado => { root.salvar-midia(m.id); } } }
                                }
                            }
                            if m.tem-arquivo: CartaoArquivo { nome: m.arquivo; minha: m.minha; abrir => { root.abrir-midia(m.id); } salvar => { root.salvar-midia(m.id); } }
                            if m.rotulo != "": HorizontalLayout {
                                spacing: 6px;
                                if m.indisponivel: Icone { source: @image-url("icones/imagem.svg"); cor: Tema.fraco; width: 14px; height: 14px; y: 2px; }
                                Text { text: m.rotulo; color: Tema.apagado; font-size: 12px; }
                            }
                            if m.texto != "": TextInput {
                                text: m.texto; read-only: true; wrap: word-wrap; single-line: false;
                                color: m.apagada ? Tema.fraco : Tema.texto; font-size: 14px; font-italic: m.apagada;
                                selection-background-color: #F4A93555;
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 4px;
                                if m.editada: Text { text: "Editada"; color: Tema.fraco; font-size: 11px; vertical-alignment: center; font-italic: true; }
                                Text { text: m.hora; color: Tema.fraco; font-size: 11px; vertical-alignment: center; }
                                if m.minha && m.status != "": Icone {
                                    source: m.status == "ERROR" ? @image-url("icones/alerta.svg") : m.status == "PENDING" ? @image-url("icones/relogio.svg") : m.status == "SENT" || m.status == "SERVER_ACK" ? @image-url("icones/tique.svg") : @image-url("icones/tiques.svg");
                                    cor: m.status == "ERROR" ? Tema.erro : m.status == "READ" || m.status == "PLAYED" ? Tema.destaque : Tema.fraco;
                                    width: 15px; height: 15px;
                                }
                            }
                        }
                        // destaque quando e o alvo de "ir para a mensagem"
                        Rectangle {
                            background: Tema.destaque.transparentize(72%);
                            border-radius: parent.border-radius;
                            opacity: root.em-destaque ? 1 : 0;
                            animate opacity { duration: 500ms; }
                        }
                        BotaoMais {
                            x: parent.width - self.width - 4px; y: 4px;
                            visivel-ao-passar: toque.has-hover && !m.apagada;
                            minha-msg: m.minha;
                            abrir(ax, ay) => {
                                Acoes.abrir-menu(m.id, m.minha, m.texto != "", root.tem-midia, ax - 200px, ay);
                            }
                        }
                    }
                    if m.reacoes.length > 0: HorizontalLayout {
                        alignment: m.minha ? end : start;
                        spacing: 4px; padding-left: 6px; padding-right: 6px;
                        for r in m.reacoes: ChipReacao { r: r; clicado => { Acoes.reagir(m.id, r.emoji); } }
                    }
                }
            }
        }
    }
}

component Compositor inherits Rectangle {
    in property <[string]> anexos;
    in property <bool> enviando;
    callback anexar();
    callback remover-anexo(int);
    callback colar() -> bool;
    in property <bool> gravando;
    in property <string> tempo-gravacao;
    in property <float> nivel;
    callback gravar();
    callback cancelar-gravacao();
    callback enviar-gravacao();
    in-out property <string> texto;
    in property <bool> pode-assinar;
    in-out property <bool> assinar;
    in property <bool> habilitado;
    callback enviar(string);
    callback trocar-assinar(bool);
    public function focar() { entrada.focus(); }
    height: corpo.preferred-height;
    background: Tema.fundo;
    property <bool> pode-enviar: (root.texto != "" || root.anexos.length > 0) && !root.enviando;
    corpo := VerticalLayout {
      padding-left: 20px; padding-right: 20px; padding-top: 10px; padding-bottom: 16px;
      spacing: 8px;
      if root.anexos.length > 0: Rectangle {
        height: faixa.preferred-height;
        border-radius: 10px; background: Tema.cartao; border-width: 1px; border-color: Tema.borda;
        faixa := VerticalLayout {
            padding: 8px; spacing: 4px;
            Text { text: root.anexos.length == 1 ? "1 arquivo para enviar · o texto vira legenda" : root.anexos.length + " arquivos para enviar · o texto vira legenda do primeiro"; color: Tema.apagado; font-size: 11px; }
            for a[i] in root.anexos: HorizontalLayout {
                spacing: 8px; height: 30px;
                VerticalLayout { alignment: center; Icone { source: @image-url("icones/arquivo.svg"); cor: Tema.destaque; width: 15px; height: 15px; } }
                Text { text: a; color: Tema.texto; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; font-size: 13px; }
                if !root.enviando: BotaoIcone { icone: @image-url("icones/fechar.svg"); tamanho: 28px; clicado => { root.remover-anexo(i); } }
            }
        }
      }
      if root.gravando: HorizontalLayout {
        spacing: 10px;
        Rectangle {
            height: 46px; border-radius: 23px; background: Tema.campo; border-width: 1px; border-color: Tema.erro.transparentize(50%);
            HorizontalLayout {
                padding-left: 8px; padding-right: 18px; spacing: 12px;
                VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/lixeira.svg"); tamanho: 34px; dica: "Descartar gravação"; clicado => { root.cancelar-gravacao(); } } }
                VerticalLayout { alignment: center; Rectangle {
                    width: 10px; height: 10px; border-radius: 5px; background: Tema.erro;
                    opacity: pisca.running ? 1 : 1;
                    pisca := Timer { interval: 500ms; running: root.gravando; triggered => { parent.opacity = parent.opacity > 0.5 ? 0.25 : 1; } }
                    animate opacity { duration: 400ms; }
                } }
                Text { text: root.tempo-gravacao; color: Tema.texto; font-size: 15px; font-weight: 600; vertical-alignment: center; font-family: "Cascadia Mono"; }
                VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle {
                    height: 6px; border-radius: 3px; background: Tema.borda;
                    Rectangle { x: 0; height: parent.height; border-radius: 3px; background: root.nivel > 0.01 ? Tema.ok : Tema.fraco; width: parent.width * min(1, root.nivel * 3); animate width { duration: 90ms; } }
                } }
                Text { text: root.nivel > 0.01 ? "Gravando" : "Sem som do microfone?"; color: root.nivel > 0.01 ? Tema.apagado : #F3B2B4; font-size: 12px; vertical-alignment: center; }
            }
        }
        VerticalLayout { alignment: end; Rectangle {
            width: 46px; height: 46px; border-radius: 23px;
            background: grav-t.has-hover ? Tema.destaque.brighter(8%) : Tema.destaque;
            Icone { source: @image-url("icones/enviar.svg"); cor: Tema.sobre-destaque; width: 20px; height: 20px; }
            grav-t := TouchArea { mouse-cursor: pointer; clicked => { root.enviar-gravacao(); } }
        } }
      }
      HorizontalLayout {
        visible: !root.gravando;
        height: root.gravando ? 0px : self.preferred-height;
        spacing: 10px;
        alignment: stretch;
        VerticalLayout {
            alignment: end;
            BotaoIcone { icone: @image-url("icones/anexar.svg"); tamanho: 46px; dica: "Anexar arquivos"; ativo: !root.enviando; clicado => { root.anexar(); } }
        }
        Rectangle {
            border-radius: 22px;
            background: Tema.campo;
            border-width: 1px;
            border-color: entrada.has-focus ? Tema.destaque.transparentize(40%) : Tema.borda;
            height: max(46px, min(140px, entrada.preferred-height + 24px));
            HorizontalLayout {
                padding-left: 18px; padding-right: 8px;
                spacing: 6px;
                FocusScope {
                    capture-key-pressed(ev) => {
                        if (ev.text == Key.Return && !ev.modifiers.shift) {
                            if (root.pode-enviar) { root.enviar(root.texto); }
                            return accept;
                        }
                        // Ctrl+V com imagem na area de transferencia: vira anexo; com texto, cola normal
                        if (ev.modifiers.control && (ev.text == "v" || ev.text == "V")) {
                            if (root.colar()) { return accept; }
                        }
                        return reject;
                    }
                    entrada := TextInput {
                        y: (parent.height - self.height) / 2;
                        height: min(self.preferred-height, 116px);
                        text <=> root.texto;
                        color: Tema.texto;
                        wrap: word-wrap;
                        single-line: false;
                        enabled: root.habilitado;
                        font-size: 14px;
                        selection-background-color: #F4A93555;
                    }
                    if root.texto == "": Text { text: root.anexos.length > 0 ? "Legenda (opcional)" : "Escreva uma mensagem"; color: Tema.fraco; vertical-alignment: center; height: parent.height; x: 0; }
                }
                if root.pode-assinar: VerticalLayout {
                    alignment: end; padding-bottom: 5px;
                    BotaoIcone {
                        icone: @image-url("icones/assinar.svg"); ligado: root.assinar; tamanho: 34px;
                        dica: root.assinar ? "Assinando: o cliente vê seu nome" : "Assinar com seu nome";
                        clicado => { root.assinar = !root.assinar; root.trocar-assinar(root.assinar); }
                    }
                }
            }
        }
        if !root.pode-enviar && !root.enviando: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: mic-t.has-hover ? Tema.realce : Tema.elevado;
                animate background { duration: 140ms; }
                Icone { source: @image-url("icones/microfone.svg"); cor: mic-t.has-hover ? Tema.destaque : Tema.apagado; width: 20px; height: 20px; }
                mic-t := TouchArea { mouse-cursor: pointer; clicked => { root.gravar(); } }
            }
        }
        if root.pode-enviar || root.enviando: VerticalLayout {
            alignment: end;
            Rectangle {
                width: 46px; height: 46px; border-radius: 23px;
                background: !root.pode-enviar ? Tema.elevado : enviar-t.has-hover ? Tema.destaque.brighter(8%) : Tema.destaque;
                animate background { duration: 160ms; }
                if !root.enviando: Icone { source: @image-url("icones/enviar.svg"); cor: !root.pode-enviar ? Tema.fraco : Tema.sobre-destaque; width: 20px; height: 20px; }
                if root.enviando: Spinner { width: 20px; height: 20px; indeterminate: true; }
                enviar-t := TouchArea { mouse-cursor: root.pode-enviar ? pointer : default; clicked => { if (root.pode-enviar) { root.enviar(root.texto); } } }
            }
        }
      }
    }
}

component SeletorSessao inherits Rectangle {
    in property <[SessaoItem]> sessoes;
    in property <int> atual;
    callback escolher(int);
    height: 52px;
    border-radius: 10px;
    background: toque.has-hover ? Tema.realce : Tema.cartao;
    animate background { duration: 140ms; }
    border-width: 1px; border-color: Tema.borda;
    property <SessaoItem> s: root.sessoes[root.atual];
    HorizontalLayout {
        padding-left: 12px; padding-right: 10px; spacing: 10px;
        VerticalLayout { alignment: center; Rectangle { width: 9px; height: 9px; border-radius: 5px; background: s.conectada ? Tema.ok : Tema.erro; } }
        VerticalLayout {
            alignment: center; spacing: 1px;
            Text { text: "SESSÃO"; color: Tema.fraco; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; }
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.sessoes.length == 0 ? "Nenhuma sessão" : s.nome; color: Tema.texto; font-weight: 600; overflow: elide; }
                if s.privada: Icone { source: @image-url("icones/cadeado.svg"); cor: Tema.apagado; width: 13px; height: 13px; y: 2px; }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; Icone { source: @image-url("icones/seta.svg"); } }
    }
    toque := TouchArea { mouse-cursor: pointer; clicked => { if (root.sessoes.length > 1) { lista.show(); } } }
    lista := PopupWindow {
        x: 0; y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Tema.elevado; border-radius: 10px; border-width: 1px; border-color: Tema.borda;
            drop-shadow-blur: 18px; drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 6px;
                for s[i] in root.sessoes: Rectangle {
                    height: 40px; border-radius: 8px;
                    background: i == root.atual ? Tema.destaque-suave : item.has-hover ? Tema.realce : transparent;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px; spacing: 10px;
                        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: s.conectada ? Tema.ok : Tema.erro; } }
                        Text { text: s.nome; color: i == root.atual ? Tema.destaque : Tema.texto; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if s.privada: VerticalLayout { alignment: center; Icone { source: @image-url("icones/cadeado.svg"); width: 13px; height: 13px; } }
                    }
                    item := TouchArea { mouse-cursor: pointer; clicked => { root.escolher(i); } }
                }
            }
        }
    }
}

component Vazio inherits VerticalLayout {
    in property <image> icone;
    in property <string> titulo;
    in property <string> texto;
    alignment: center;
    spacing: 10px;
    HorizontalLayout { alignment: center; Rectangle {
        width: 64px; height: 64px; border-radius: 32px; background: Tema.cartao;
        Icone { source: root.icone; cor: Tema.fraco; width: 28px; height: 28px; }
    } }
    Text { text: root.titulo; color: Tema.texto; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
    Text { text: root.texto; color: Tema.apagado; horizontal-alignment: center; wrap: word-wrap; }
}

component TelaAtendimento inherits Rectangle {
    in property <[SessaoItem]> sessoes;
    in-out property <int> sessao-atual;
    in property <string> estado-sessao;
    in property <string> usuario;
    in property <bool> ao-vivo;
    in property <[Conversa]> conversas;
    in property <bool> carregando-conversas;
    in-out property <int> filtro;
    in property <string> conversa-jid;
    in property <string> conversa-nome;
    in property <string> conversa-info;
    in property <string> conversa-inicial;
    in property <int> conversa-cor;
    in property <[Mensagem]> mensagens;
    in property <bool> tem-mais;
    in property <bool> carregando;
    in-out property <bool> assinar;
    in property <bool> pode-assinar;
    in-out property <string> rascunho;
    in-out property <string> busca;
    callback escolher-sessao(int);
    callback buscar(string);
    callback filtrar(int);
    callback abrir(string);
    callback enviar(string);
    callback mais-antigas();
    callback mais-conversas();
    callback sair();
    callback trocar-assinar(bool);
    in property <[string]> anexos;
    in property <bool> enviando;
    callback anexar();
    callback remover-anexo(int);
    callback colar() -> bool;
    callback abrir-midia(string);
    callback salvar-midia(string);
    callback tocar(string);
    in property <bool> gravando;
    in property <string> tempo-gravacao;
    in property <float> nivel;
    callback gravar();
    callback cancelar-gravacao();
    callback enviar-gravacao();
    public function rolar-fim() { lista-msgs.content-y = min(0px, lista-msgs.visible-height - lista-msgs.content-height); }
    public function focar-compositor() { compositor.focar(); }
    property <bool> no-fim: lista-msgs.content-y <= lista-msgs.visible-height - lista-msgs.content-height + 80px;
    public function esta-no-fim() -> bool { return root.no-fim; }

    HorizontalLayout {
        // ---- coluna das conversas ----
        Rectangle {
            width: 360px;
            background: Tema.lateral;
            VerticalLayout {
                padding: 14px; padding-bottom: 6px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Marca { tamanho: 26px; }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px; width: estado-t.preferred-width + 30px; border-radius: 12px;
                            background: root.ao-vivo ? #46A75820 : #E5484D20;
                            HorizontalLayout {
                                padding-left: 9px; spacing: 6px;
                                VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.ao-vivo ? Tema.ok : Tema.erro; } }
                                estado-t := Text { text: root.ao-vivo ? "Ao vivo" : "Reconectando"; color: root.ao-vivo ? #8FD19E : #F3B2B4; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                    }
                    BotaoIcone { icone: @image-url("icones/mais.svg"); tamanho: 32px; dica: "Nova conversa"; clicado => { Painel.novo-aberto = true; Painel.abrir-novo(); } }
                    BotaoIcone { icone: @image-url("icones/config.svg"); tamanho: 32px; dica: "Configurações"; clicado => { Painel.config-aberto = true; } }
                    BotaoIcone { icone: @image-url("icones/sair.svg"); tamanho: 32px; dica: "Sair (" + root.usuario + ")"; clicado => { root.sair(); } }
                }
                SeletorSessao { sessoes: root.sessoes; atual: root.sessao-atual; escolher(i) => { root.sessao-atual = i; root.escolher-sessao(i); } }
                if root.estado-sessao != "": HorizontalLayout {
                    spacing: 8px;
                    Icone { source: @image-url("icones/wifi-off.svg"); cor: Tema.erro; width: 14px; height: 14px; }
                    Text { text: root.estado-sessao; color: #F3B2B4; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                }
                // busca
                Rectangle {
                    height: 40px; border-radius: 20px;
                    background: Tema.campo;
                    border-width: 1px; border-color: busca-in.has-focus ? Tema.destaque.transparentize(40%) : Tema.borda;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 6px; spacing: 10px;
                        VerticalLayout { alignment: center; Icone { source: @image-url("icones/busca.svg"); width: 16px; height: 16px; cor: Tema.fraco; } }
                        Rectangle {
                            busca-in := TextInput {
                                y: (parent.height - self.height) / 2;
                                text <=> root.busca; color: Tema.texto; single-line: true;
                                selection-background-color: #F4A93555;
                                edited => { root.buscar(self.text); }
                            }
                            if root.busca == "": Text { x: 0; text: "Buscar conversa ou número"; color: Tema.fraco; vertical-alignment: center; height: parent.height; }
                        }
                        if root.busca != "": VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/fechar.svg"); tamanho: 28px; clicado => { root.busca = ""; root.buscar(""); } } }
                    }
                }
                HorizontalLayout {
                    spacing: 6px; alignment: start;
                    Aba { texto: "Todas"; ativa: root.filtro == 0; clicada => { root.filtro = 0; root.filtrar(0); } }
                    Aba { texto: "Privadas"; ativa: root.filtro == 1; clicada => { root.filtro = 1; root.filtrar(1); } }
                    Aba { texto: "Grupos"; ativa: root.filtro == 2; clicada => { root.filtro = 2; root.filtrar(2); } }
                    Aba { texto: "Arquivadas"; ativa: root.filtro == 3; clicada => { root.filtro = 3; root.filtrar(3); } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    lista-conversas := ListView {
                        for c in root.conversas: ItemConversa {
                            c: c;
                            selecionada: c.jid == root.conversa-jid;
                            arquivada: root.filtro == 3;
                            clicado => { root.abrir(c.jid); }
                        }
                        changed content-y => {
                            if (self.content-height > self.visible-height && self.content-y <= self.visible-height - self.content-height + 60px) { root.mais-conversas(); }
                        }
                    }
                    if root.carregando-conversas && root.conversas.length == 0: Spinner { width: 28px; height: 28px; indeterminate: true; }
                    if !root.carregando-conversas && root.conversas.length == 0: Vazio {
                        icone: root.busca != "" ? @image-url("icones/busca.svg") : @image-url("icones/conversa.svg");
                        titulo: root.busca != "" ? "Nada encontrado" : "Nenhuma conversa";
                        texto: root.busca != "" ? "Tente outro nome ou número." : "As conversas desta sessão aparecem aqui.";
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Tema.borda; }
        // ---- conversa aberta ----
        Rectangle {
            background: Tema.fundo;
            if root.conversa-jid == "": Vazio {
                icone: @image-url("icones/conversa.svg");
                titulo: "Escolha uma conversa";
                texto: "Selecione uma conversa na lista para ler e responder.";
            }
            VerticalLayout {
                visible: root.conversa-jid != "";
                Rectangle {
                    height: 68px;
                    background: Tema.lateral;
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 16px; spacing: 12px;
                        // clicar no nome/foto abre as informacoes
                        Rectangle {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout { alignment: center; Avatar { inicial: root.conversa-inicial; cor: root.conversa-cor; grupo: root.conversa-jid.character-count > 5 && root.conversa-info == "Grupo"; tamanho: 40px; foto: Painel.cab-foto; tem-foto: Painel.cab-tem-foto; } }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    Text { text: root.conversa-nome; color: Tema.texto; font-weight: 700; font-size: 16px; overflow: elide; }
                                    Text { text: root.conversa-info; color: Tema.apagado; font-size: 12px; overflow: elide; }
                                }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { Painel.info-aberto = !Painel.info-aberto; Painel.alternar-info(); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/busca.svg"); ligado: Acoes.busca-aberta; tamanho: 38px; dica: "Buscar na conversa"; clicado => { Acoes.alternar-busca(); } } }
                        VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/info.svg"); tamanho: 34px; ligado: Painel.info-aberto; dica: "Informações"; clicado => { Painel.info-aberto = !Painel.info-aberto; Painel.alternar-info(); } } }
                        VerticalLayout { alignment: center; Rectangle {
                            width: 34px; height: 34px;
                            BotaoIcone { icone: @image-url("icones/opcoes.svg"); tamanho: 34px; dica: "Mais opções"; clicado => { menu-cab.show(); } }
                            menu-cab := PopupWindow {
                                x: 34px - 224px; y: 40px;
                                close-policy: close-on-click-outside;
                                MenuConversa {
                                    jid: root.conversa-jid; fixada: Painel.cab-fixada; silenciada: Painel.cab-silenciada;
                                    arquivada: Painel.cab-arquivada; nao-lida: Painel.cab-nao-lida;
                                    fechar => { menu-cab.close(); }
                                }
                            }
                        } }
                    }
                }
                Rectangle { height: 1px; background: Tema.borda; }
                if Acoes.busca-aberta: PainelBusca { }
                Rectangle {
                    vertical-stretch: 1;
                    lista-msgs := ListView {
                        for m in root.mensagens: Balao {
                            m: m; largura: lista-msgs.visible-width;
                            abrir-midia(id) => { root.abrir-midia(id); }
                            salvar-midia(id) => { root.salvar-midia(id); }
                            tocar(id) => { root.tocar(id); }
                            centralizar(y, h) => { lista-msgs.content-y = min(0px, max(lista-msgs.visible-height - lista-msgs.content-height, -(y - (lista-msgs.visible-height - h) / 2))); }
                        }
                    }
                    if root.tem-mais: VerticalLayout {
                        alignment: start;
                        HorizontalLayout {
                            alignment: center; padding-top: 10px;
                            Rectangle {
                                height: 30px; width: mais-t.preferred-width + (root.carregando ? 52px : 28px); border-radius: 15px;
                                background: mais-toque.has-hover ? Tema.realce : Tema.elevado;
                                border-width: 1px; border-color: Tema.borda;
                                drop-shadow-blur: 10px; drop-shadow-color: #00000060;
                                HorizontalLayout {
                                    alignment: center; spacing: 8px;
                                    if root.carregando: Spinner { width: 14px; height: 14px; indeterminate: true; }
                                    mais-t := Text { text: "Mensagens anteriores"; color: Tema.apagado; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                }
                                mais-toque := TouchArea { mouse-cursor: pointer; clicked => { root.mais-antigas(); } }
                            }
                        }
                    }
                    if root.carregando && root.mensagens.length == 0: Spinner { width: 28px; height: 28px; indeterminate: true; }
                    Rectangle {
                        opacity: root.no-fim ? 0 : 1;
                        visible: self.opacity > 0.01;
                        animate opacity { duration: 180ms; }
                        x: parent.width - 60px; y: parent.height - (root.no-fim ? 44px : 60px);
                        animate y { duration: 220ms; easing: ease-out; }
                        width: 40px; height: 40px; border-radius: 20px;
                        background: descer-t.has-hover ? Tema.realce : Tema.elevado;
                        border-width: 1px; border-color: Tema.borda;
                        drop-shadow-blur: 12px; drop-shadow-color: #00000080;
                        Icone { source: @image-url("icones/descer.svg"); }
                        descer-t := TouchArea { mouse-cursor: pointer; clicked => { root.rolar-fim(); } }
                    }
                }
                if Acoes.resp-id != "": FaixaResposta { }
                if Acoes.edit-id != "": FaixaEdicao { }
                compositor := Compositor {
                    texto <=> root.rascunho;
                    pode-assinar: root.pode-assinar;
                    assinar <=> root.assinar;
                    habilitado: root.conversa-jid != "";
                    anexos: root.anexos;
                    enviando: root.enviando;
                    anexar => { root.anexar(); }
                    remover-anexo(i) => { root.remover-anexo(i); }
                    colar => { return root.colar(); }
                    gravando: root.gravando;
                    tempo-gravacao: root.tempo-gravacao;
                    nivel: root.nivel;
                    gravar => { root.gravar(); }
                    cancelar-gravacao => { root.cancelar-gravacao(); }
                    enviar-gravacao => { root.enviar-gravacao(); }
                    enviar(t) => { root.enviar(t); }
                    trocar-assinar(v) => { root.trocar-assinar(v); }
                }
            }
        }
        PainelInfo { }
    }
    CamadaAcoes {
        rolar-estimado => {
            lista-msgs.content-y = min(0px, max(lista-msgs.visible-height - lista-msgs.content-height, -((lista-msgs.content-height - lista-msgs.visible-height) * (Acoes.alvo-indice / max(1, root.mensagens.length - 1)))));
        }
    }
}

component Aviso inherits Rectangle {
    in property <string> texto;
    callback fechar();
    width: min(520px, corpo.preferred-width + 20px);
    height: corpo.preferred-height;
    border-radius: 10px;
    background: Tema.erro-fundo;
    border-width: 1px; border-color: Tema.erro.transparentize(50%);
    drop-shadow-blur: 20px; drop-shadow-color: #000000A0;
    corpo := HorizontalLayout {
        padding: 12px; padding-right: 6px; spacing: 10px;
        VerticalLayout { alignment: center; Icone { source: @image-url("icones/alerta.svg"); cor: Tema.erro; } }
        Text { text: root.texto; color: #F3B2B4; wrap: word-wrap; vertical-alignment: center; max-width: 420px; }
        VerticalLayout { alignment: center; BotaoIcone { icone: @image-url("icones/fechar.svg"); tamanho: 28px; clicado => { root.fechar(); } } }
    }
}

export component App inherits Window {
    title: Painel.titulo;
    icon: @image-url("icone.png");
    preferred-width: 1240px;
    preferred-height: 800px;
    min-width: 860px;
    min-height: 560px;
    background: Tema.fundo;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    init => { Painel.janela-altura = root.height; }
    changed height => { Painel.janela-altura = root.height; }

    // 0 = servidor, 1 = entrar, 2 = atendimento
    in-out property <int> tela: 0;
    in property <string> versao;

    in-out property <string> endereco;
    in property <string> erro-servidor;
    in property <bool> ocupado;
    in property <bool> mostrar-cert;
    in property <string> cert-impressao;
    in property <string> cert-titular;
    in property <string> cert-emissor;
    in property <string> cert-validade;
    in property <bool> cert-mudou;
    in property <bool> cert-liberado;
    in property <string> cert-prefixo;
    callback verificar(string);
    callback confiar();
    callback cancelar-cert();
    callback cert-digitado(string);

    in property <string> servidor;
    in-out property <string> email;
    in property <string> erro-entrar;
    in property <bool> pede-codigo;
    callback entrar(string, string, string);
    callback trocar-servidor();

    in property <[SessaoItem]> sessoes;
    in-out property <int> sessao-atual;
    in property <string> estado-sessao;
    in property <string> usuario;
    in property <bool> ao-vivo;
    in property <[Conversa]> conversas;
    in property <bool> carregando-conversas;
    in-out property <int> filtro;
    in property <string> conversa-jid;
    in property <string> conversa-nome;
    in property <string> conversa-info;
    in property <string> conversa-inicial;
    in property <int> conversa-cor;
    in property <[Mensagem]> mensagens;
    in property <bool> tem-mais;
    in property <bool> carregando;
    in-out property <string> aviso;
    in-out property <bool> assinar;
    in property <bool> pode-assinar;
    in-out property <string> rascunho;
    in-out property <string> busca;
    callback escolher-sessao(int);
    callback buscar(string);
    callback filtrar(int);
    callback abrir(string);
    callback enviar(string);
    callback mais-antigas();
    callback mais-conversas();
    callback sair();
    callback trocar-assinar(bool);
    in property <[string]> anexos;
    in property <bool> enviando;
    callback anexar();
    callback remover-anexo(int);
    callback colar() -> bool;
    callback abrir-midia(string);
    callback salvar-midia(string);
    callback tocar(string);
    in property <bool> gravando;
    in property <string> tempo-gravacao;
    in property <float> nivel;
    callback gravar();
    callback cancelar-gravacao();
    callback enviar-gravacao();
    public function rolar-fim() { atendimento.rolar-fim(); }
    public function esta-no-fim() -> bool { atendimento.esta-no-fim() }
    public function focar-compositor() { atendimento.focar-compositor(); }

    if root.tela == 0: TelaServidor {
        endereco <=> root.endereco;
        erro: root.erro-servidor;
        ocupado: root.ocupado;
        mostrar-cert: root.mostrar-cert;
        cert-impressao: root.cert-impressao;
        cert-titular: root.cert-titular;
        cert-emissor: root.cert-emissor;
        cert-validade: root.cert-validade;
        cert-mudou: root.cert-mudou;
        cert-liberado: root.cert-liberado;
        cert-prefixo: root.cert-prefixo;
        versao: root.versao;
        verificar(e) => { root.verificar(e); }
        confiar => { root.confiar(); }
        cancelar => { root.cancelar-cert(); }
        cert-digitado(t) => { root.cert-digitado(t); }
    }
    if root.tela == 1: TelaEntrar {
        servidor: root.servidor;
        email <=> root.email;
        erro: root.erro-entrar;
        ocupado: root.ocupado;
        pede-codigo: root.pede-codigo;
        versao: root.versao;
        entrar(e, s, c) => { root.entrar(e, s, c); }
        trocar-servidor => { root.trocar-servidor(); }
    }
    atendimento := TelaAtendimento {
        opacity: root.tela == 2 ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 260ms; easing: ease-out; }
        sessoes: root.sessoes;
        sessao-atual <=> root.sessao-atual;
        estado-sessao: root.estado-sessao;
        usuario: root.usuario;
        ao-vivo: root.ao-vivo;
        conversas: root.conversas;
        carregando-conversas: root.carregando-conversas;
        filtro <=> root.filtro;
        conversa-jid: root.conversa-jid;
        conversa-nome: root.conversa-nome;
        conversa-info: root.conversa-info;
        conversa-inicial: root.conversa-inicial;
        conversa-cor: root.conversa-cor;
        mensagens: root.mensagens;
        tem-mais: root.tem-mais;
        carregando: root.carregando;
        assinar <=> root.assinar;
        pode-assinar: root.pode-assinar;
        rascunho <=> root.rascunho;
        busca <=> root.busca;
        escolher-sessao(i) => { root.escolher-sessao(i); }
        buscar(t) => { root.buscar(t); }
        filtrar(f) => { root.filtrar(f); }
        abrir(j) => { root.abrir(j); }
        enviar(t) => { root.enviar(t); }
        mais-antigas => { root.mais-antigas(); }
        mais-conversas => { root.mais-conversas(); }
        sair => { root.sair(); }
        trocar-assinar(v) => { root.trocar-assinar(v); }
        anexos: root.anexos;
        enviando: root.enviando;
        anexar => { root.anexar(); }
        remover-anexo(i) => { root.remover-anexo(i); }
        colar => { return root.colar(); }
        abrir-midia(id) => { root.abrir-midia(id); }
        salvar-midia(id) => { root.salvar-midia(id); }
        tocar(id) => { root.tocar(id); }
        gravando: root.gravando;
        tempo-gravacao: root.tempo-gravacao;
        nivel: root.nivel;
        gravar => { root.gravar(); }
        cancelar-gravacao => { root.cancelar-gravacao(); }
        enviar-gravacao => { root.enviar-gravacao(); }
    }
    CamadasPainel { x: 0px; y: 0px; width: root.width; height: root.height; }
    Aviso {
        x: (root.width - self.width) / 2;
        y: root.aviso != "" ? 16px : -self.height - 20px;
        opacity: root.aviso != "" ? 1 : 0;
        visible: self.opacity > 0.01 || root.aviso != "";
        animate y { duration: 300ms; easing: ease-out-back; }
        animate opacity { duration: 200ms; }
        texto: root.aviso;
        fechar => { root.aviso = ""; }
    }
}
