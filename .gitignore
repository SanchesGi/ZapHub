# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media files (downloaded by app)
/data/media/*
!/data/media/.gitkeep
# midias ficticias geradas pelo scripts/demo/popular-demo.ts
/data/demo-midia/
/public/media/*
server.log
/logs/

# minha versao: NUNCA versionar segredos/estado (vai para o GitHub pessoal)
# certificado: a chave privada da CA e do servidor ficam SO no servidor
/certificados/*
!/certificados/.gitkeep
# certificado publico + instalador gerados com o IP da maquina (recriados em cada servidor)
/public/certificado-*.crt
/public/instalar-certificado-*.bat
/instalar-certificado-*.bat
# arquivos de execucao (log/estado do servico)
logs-prod.txt
logs-prod.anterior.txt
logs-servico.txt
*.flag
# midia das conversas (dados dos clientes) e uploads
/uploads/
# minha versao: controle da atualizacao automatica (so na VM) e builds temporarios do atualizar.sh
.versao-no-ar
.versao-falhou
.atualizando.lock
.atualizar-pelo-painel
/.next.new/
/.next.old/

# minha versao: copia parcial duplicada (sobra de descompactacao, sem src/). Nao versionar.

# Quadro de coordenacao dos agentes (estado de trabalho, nao vai para o git)
.claude/quadro/
