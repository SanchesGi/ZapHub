# ==============================================================================
# ZapHub — configuração (modelo)
# ==============================================================================
# Copie para .env e ajuste:   cp .env.example .env
# O deploy/instalar.sh já cria o .env sozinho numa instalação nova (com segredo e banco).
# Variáveis NEXT_PUBLIC_* entram no build: depois de mudar, rode "npm run build" de novo.
# Nunca envie o .env para o git (ele já está no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Obrigatórias
# ------------------------------------------------------------------------------

# Banco MariaDB/MySQL (o projeto usa só MySQL/MariaDB).
# O deploy/configurar-mariadb.sh cria o banco e o usuário e mostra esta linha pronta.
DATABASE_URL="mysql://zaphub:SENHA_DO_BANCO@127.0.0.1:3306/zaphub"

# Segredo da sessão e da criptografia. Gere com:  openssl rand -base64 32
# Em produção o servidor não sobe com o valor de exemplo.
# GUARDE ESTE VALOR: as credenciais do WhatsApp no banco são cifradas com ele; trocar desconecta as sessões.
AUTH_SECRET="troque-por-um-segredo-gerado-com-openssl-rand-base64-32"

# Endereço pelo qual o painel é acessado (usado em links, CORS do socket e redirecionamentos).
BASE_URL="https://SEU_IP_OU_DOMINIO:3443"
NEXTAUTH_URL="https://SEU_IP_OU_DOMINIO:3443"
NEXT_PUBLIC_APP_URL="https://SEU_IP_OU_DOMINIO:3443"
NEXT_PUBLIC_API_URL="https://SEU_IP_OU_DOMINIO:3443/api"

# NODE_ENV nao vai aqui: o servico e o "npm start" usam producao; o "npm run dev" usa desenvolvimento.

# ------------------------------------------------------------------------------
# 2. Portas e HTTPS
# ------------------------------------------------------------------------------
# Com certificado em ./certificados (deploy/gerar-certificado.sh), o HTTPS é o servidor principal
# e o HTTP fica só em 127.0.0.1 redirecionando para o HTTPS. Sem certificado, o HTTP é o principal.
# Notificações do navegador e o microfone (mensagem de voz) exigem HTTPS.

# Porta HTTP (padrão do código: 3030). Tem que ser diferente da HTTPS_PORT.
PORT="3030"
# Porta HTTPS (padrão 3443).
HTTPS_PORT="3443"
NEXT_PUBLIC_HTTPS_PORT="3443"
# "true" desliga o HTTPS próprio (ex.: atrás de um proxy reverso Nginx/Caddy com Let's Encrypt).
HTTPS_DISABLED="false"
# "false" desliga o redirecionamento HTTP -> HTTPS.
# HTTP_REDIRECT_HTTPS="true"

# Nome do host (usado só para montar origens e redirecionamentos; não define a interface de escuta).
# HOSTNAME="localhost"

# ------------------------------------------------------------------------------
# 3. Idioma e fuso
# ------------------------------------------------------------------------------
TZ="America/Sao_Paulo"
# Idioma padrão do painel quando o usuário ainda não escolheu (pt-BR | en). Cada um muda no seletor.
DEFAULT_LANGUAGE="pt-BR"

# ------------------------------------------------------------------------------
# 4. WhatsApp
# ------------------------------------------------------------------------------
# Nível de log do Baileys (fatal | error | warn | info | debug | trace). Produção: error.
BAILEYS_LOG_LEVEL="error"

# Enviar ao WhatsApp silenciar/fixar/arquivar/marcar como lida feitos no painel.
# "false" (recomendado): fica só no painel. Um envio malformado pode desconectar todos os aparelhos da conta.
SINCRONIZAR_ESTADO_CHAT="false"

# Mensagem de voz: bitrate do Opus e redução de ruído no servidor (precisa do ffmpeg instalado).
# VOICE_OPUS_BITRATE="48k"   (bem acima disso o WhatsApp do Android recusa tocar)
# VOICE_DENOISE="true"
# Caminho completo do ffmpeg, se nao estiver em /usr/bin, /usr/local/bin ou /bin.
# FFMPEG_PATH="/opt/ffmpeg/bin/ffmpeg"

# ------------------------------------------------------------------------------
# 5. Painel
# ------------------------------------------------------------------------------
# Conversas carregadas por página na lista do chat.
NEXT_PUBLIC_CHAT_PAGE_SIZE="50"
# Deixar buscadores indexarem as páginas públicas (true | false).
NEXT_PUBLIC_ALLOW_INDEXING="false"
# Avisar o Super Administrador quando houver versão nova no GitHub (consulta o "origin" do git local).
ENABLE_AUTO_UPDATE_CHECK="true"

# ------------------------------------------------------------------------------
# 6. Segurança (opcional)
# ------------------------------------------------------------------------------
# Chave própria (texto longo e aleatório, ex.: openssl rand -hex 32) para cifrar as credenciais do WhatsApp no banco.
# Sem ela, a chave é derivada do AUTH_SECRET. Guarde-a junto com o AUTH_SECRET.
# ENCRYPTION_KEY=""

# "true" desliga a Content-Security-Policy (só para diagnosticar; não use em produção).
# CSP_DISABLED="false"

# Atrás de um proxy reverso (Nginx/Caddy): "true" faz o IP do cliente vir do X-Forwarded-For (última entrada).
# Sem proxy, deixe desligado: o IP vem da conexão e o cliente não consegue forjá-lo (limites e registros de acesso).
# TRUST_PROXY="false"

# Mídia recebida: tamanho máximo por arquivo (MB) e espaço mínimo livre no disco das mídias (MB) para baixar.
# MIDIA_MAX_MB="100"
# MIDIA_MIN_LIVRE_MB="1024"

# Modo demonstracao (dados ficticios, sem WhatsApp, nada e alterado nem enviado). Veja docs/DEMO.md.
# Use so num servidor e num banco proprios da demonstracao.
# ZAPHUB_DEMO="true"
# NEXT_PUBLIC_ZAPHUB_DEMO="true"

# ------------------------------------------------------------------------------
# 7. Testes (só desenvolvimento)
# ------------------------------------------------------------------------------
# Banco DESCARTÁVEL para "npm run test:banco". O nome precisa conter "test"; os testes apagam o que criam.
# TEST_DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/zaphub_teste"
